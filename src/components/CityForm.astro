---
const { pathname } = Astro.url;
const currentLang = pathname.startsWith('/en') ? 'en' : 'es';
const directusUrl = import.meta.env.PUBLIC_DIRECTUS_URL || 'https://panel.nicotatuaggi.com';

const t = {
  es: {
    eyebrow: "¿A dónde debería ir?",
    heading: "Pedí tu ciudad",
    description: "Enterate antes que nadie cuándo Nico llega a tu ciudad. Dejá tus datos y te avisamos apenas se confirme una fecha.",
    nameLabel: "Tu Nombre",
    contactLabel: "Email",
    cityLabel: "Ciudad que pedís",
    btnSubmit: "Pedir Ciudad",
    btnSending: "ENVIANDO...",
    msgSuccess: "¡PEDIDO ENVIADO CON ÉXITO!",
    msgError: "HUBO UN ERROR. INTENTÁ DE NUEVO.",
    invalidCity: "POR FAVOR, SELECCIONA UNA CIUDAD DE LA LISTA."
  },
  en: {
    eyebrow: "Where should I go?",
    heading: "Request your city",
    description: "Be the first to know when Nico comes to your city. Leave your details and we'll notify you as soon as a date is confirmed.",
    nameLabel: "Your Name",
    contactLabel: "Email",
    cityLabel: "Requested City",
    btnSubmit: "Request City",
    btnSending: "SENDING...",
    msgSuccess: "REQUEST SENT SUCCESSFULLY!",
    msgError: "THERE WAS AN ERROR. TRY AGAIN.",
    invalidCity: "PLEASE SELECT A VALID CITY FROM THE LIST."
  }
};
---
<div class="w-full grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-20 items-center">
  {/* Copy */}
  <div class="text-left">
    <h2 class="text-tattoo-gold text-xs tracking-[0.3em] uppercase mb-4">{t[currentLang].eyebrow}</h2>
    <h3 class="font-display text-4xl md:text-5xl text-white mb-6 leading-tight">{t[currentLang].heading}</h3>
    <p class="text-tattoo-silver/70 text-sm md:text-base leading-relaxed max-w-md">{t[currentLang].description}</p>
  </div>

  {/* Form */}
  <form id="city-form" class="flex flex-col gap-7" data-lang={currentLang} data-directus-url={directusUrl}>
    <div>
      <label for="name" class="sr-only">{t[currentLang].nameLabel}</label>
      <input type="text" id="name" name="name" required minlength="2" placeholder={t[currentLang].nameLabel} class="w-full bg-transparent border-b border-white/15 pb-3 text-white focus:border-tattoo-gold focus:outline-none transition-colors placeholder:text-white/40 text-base font-light tracking-wide">
    </div>

    <div>
      <label for="contact" class="sr-only">{t[currentLang].contactLabel}</label>
      <input type="email" id="contact" name="contact" required placeholder={t[currentLang].contactLabel} class="w-full bg-transparent border-b border-white/15 pb-3 text-white focus:border-tattoo-gold focus:outline-none transition-colors placeholder:text-white/40 text-base font-light tracking-wide">
    </div>

    <div class="relative">
      <label for="city-input" class="sr-only">{t[currentLang].cityLabel}</label>
      <input type="text" id="city-input" autocomplete="off" required placeholder={t[currentLang].cityLabel} class="w-full bg-transparent border-b border-white/15 pb-3 text-white focus:border-tattoo-gold focus:outline-none transition-colors placeholder:text-white/40 text-base font-light tracking-wide">
      <input type="hidden" name="city" id="city-hidden" required>
      <ul id="city-autocomplete-list" class="absolute z-50 w-full bg-[#111] border border-white/10 max-h-48 overflow-y-auto hidden mt-1 shadow-xl"></ul>
    </div>

    <button id="submit-btn" type="submit" class="w-full sm:w-auto self-start bg-tattoo-gold text-black font-black uppercase tracking-[0.25em] py-4 px-10 mt-2 hover:bg-white transition-colors duration-500 text-xs">
      {t[currentLang].btnSubmit}
    </button>
    <p id="form-message" class="hidden text-xs tracking-[0.3em] uppercase font-bold"></p>
  </form>
</div>

<script>
  const form = document.getElementById('city-form');
  const btn = document.getElementById('submit-btn');
  const msg = document.getElementById('form-message');
  const cityInput = document.getElementById('city-input');
  const cityHidden = document.getElementById('city-hidden');
  const autocompleteList = document.getElementById('city-autocomplete-list');

  const messages = {
    es: { sending: 'ENVIANDO...', submit: 'PEDIR CIUDAD', success: '¡PEDIDO ENVIADO CON ÉXITO!', error: 'HUBO UN ERROR. INTENTÁ DE NUEVO.', invalidCity: 'POR FAVOR, SELECCIONA UNA CIUDAD DE LA LISTA.' },
    en: { sending: 'SENDING...', submit: 'REQUEST CITY', success: 'REQUEST SENT SUCCESSFULLY!', error: 'THERE WAS AN ERROR. TRY AGAIN.', invalidCity: 'PLEASE SELECT A VALID CITY FROM THE LIST.' }
  }

  // --- AUTOCOMPLETE LOGIC (Nominatim API) ---
  let timeoutId;
  let isCitySelected = false;

  cityInput.addEventListener('input', (e) => {
      clearTimeout(timeoutId);
      const query = e.target.value;
      isCitySelected = false; // Reset verification on new input
      cityHidden.value = '';

      if (query.length < 3) {
          autocompleteList.innerHTML = '';
          autocompleteList.classList.add('hidden');
          return;
      }

      timeoutId = setTimeout(async () => {
          try {
              // Nominatim API: Search for cities/towns
              const res = await fetch(`https://nominatim.openstreetmap.org/search?format=json&q=${encodeURIComponent(query)}&featuretype=city,town,village&addressdetails=1&limit=5`, {
                  headers: {
                      'Accept-Language': form.getAttribute('data-lang') === 'en' ? 'en-US,en;q=0.9' : 'es-ES,es;q=0.9'
                  }
              });
              const data = await res.json();
              
              autocompleteList.innerHTML = '';
              
              const cleanedData = [];
              const uniqueNames = new Set();
              
              if (data.length > 0) {
                  data.forEach(place => {
                      if(!place.address) return;
                      // Fallbacks to get the shortest clean name
                      let cityName = place.name || place.address.city || place.address.town || place.address.village;
                      const countryName = place.address.country;
                      
                      if (cityName && countryName) {
                          const cleanName = `${cityName}, ${countryName}`;
                          if (!uniqueNames.has(cleanName)) {
                              uniqueNames.add(cleanName);
                              cleanedData.push({ cleanName, originalData: place });
                          }
                      }
                  });

                  cleanedData.forEach(item => {
                      const li = document.createElement('li');
                      li.className = 'px-4 py-3 text-sm text-white/80 hover:bg-tattoo-gold hover:text-black cursor-pointer transition-colors border-b border-white/5 last:border-none';
                      li.textContent = item.cleanName;
                      
                      li.addEventListener('click', () => {
                          cityInput.value = item.cleanName;
                          cityHidden.value = item.cleanName; // Store the validated city
                          isCitySelected = true;
                          autocompleteList.innerHTML = '';
                          autocompleteList.classList.add('hidden');
                      });
                      autocompleteList.appendChild(li);
                  });
                  
                  if (cleanedData.length > 0) {
                      autocompleteList.classList.remove('hidden');
                  } else {
                      autocompleteList.classList.add('hidden');
                  }
              } else {
                  autocompleteList.classList.add('hidden');
              }
          } catch (error) {
              console.error("Autocomplete error:", error);
          }
      }, 500); // 500ms debounce
  });

  // Hide list if clicked outside
  document.addEventListener('click', (e) => {
      if (e.target !== cityInput && e.target !== autocompleteList) {
          autocompleteList.classList.add('hidden');
      }
  });

  // --- FORM SUBMIT LOGIC ---
  form.addEventListener('submit', async (e) => {
    e.preventDefault(); 
    const lang = form.getAttribute('data-lang');

    // Block submission if city wasn't explicitly selected from the dropdown
    if (!isCitySelected || !cityHidden.value) {
        msg.innerText = messages[lang].invalidCity;
        msg.classList.remove('hidden', 'text-tattoo-gold');
        msg.classList.add('text-red-500');
        return;
    }
    
    btn.innerText = messages[lang].sending;
    btn.disabled = true;

    const formData = new FormData(form);
    const data = Object.fromEntries(formData);

    const directusUrl = form.getAttribute('data-directus-url');

    try {
      const res = await fetch(`${directusUrl}/items/cityRequest`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
      });

      if (res.ok) {
        msg.innerText = messages[lang].success;
        msg.classList.remove('hidden', 'text-red-500');
        msg.classList.add('text-tattoo-gold');
        form.reset(); 
      } else {
        throw new Error('Error al enviar');
      }
    } catch (error) {
      msg.innerText = messages[lang].error;
      msg.classList.remove('hidden', 'text-tattoo-gold');
      msg.classList.add('text-red-500');
    }

    btn.innerText = messages[lang].submit;
    btn.disabled = false;
  });
</script>

