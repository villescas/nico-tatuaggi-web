---
const { titulo, imagenUrl, sede, linkVideo, esVideo, iaEtiquetas } = Astro.props;
const tagsArray = Array.isArray(iaEtiquetas) ? iaEtiquetas : (typeof iaEtiquetas === 'string' ? iaEtiquetas.split(',').map(s=>s.trim()) : []);
const uniqueId = `tattoo-${Math.random().toString(36).substr(2, 9)}`;

function extractYoutubeId(url) {
    if (!url) return null;
    const regExp = /^.*(youtu.be\/|v\/|u\/\w\/|embed\/|watch\?v=|&v=)([^#&?]*).*/;
    const match = url.match(regExp);
    return (match && match[2].length === 11) ? match[2] : null;
}

let embedUrl = null;
let finalImageUrl = imagenUrl;
let isYoutube = false;
let isInstagram = false;
let isRawVideo = false;

if (esVideo && linkVideo) {
    const ytId = extractYoutubeId(linkVideo);
    if (ytId) {
        isYoutube = true;
        embedUrl = `https://www.youtube.com/embed/${ytId}?autoplay=1&mute=0&controls=1&showinfo=0&rel=0&loop=1&playlist=${ytId}&playsinline=1`;
        if (!finalImageUrl) {
            finalImageUrl = `https://img.youtube.com/vi/${ytId}/hqdefault.jpg`;
        }
    } else if (linkVideo.includes('instagram.com/')) {
        isInstagram = true;
        const base = linkVideo.split('?')[0];
        const cleanBase = base.endsWith('/') ? base.slice(0, -1) : base;
        embedUrl = `${cleanBase}/embed/`;
    } else {
        isRawVideo = true;
        embedUrl = linkVideo;
    }
} else if (finalImageUrl && (finalImageUrl.includes('.mp4') || finalImageUrl.includes('.webm') || finalImageUrl.includes('.mov'))) {
    // Edge case: uploaded raw video file masquerading as a cover image
    isRawVideo = true;
}
---

{/* 1. THUMBNAIL EN LA GRILLA */}
<div class="relative group overflow-hidden border border-tattoo-gold/20 hover:border-tattoo-gold transition-all duration-500 h-full w-full cursor-pointer tattoo-trigger flex flex-col" data-target={`modal-${uniqueId}`}>
  <div class="relative w-full bg-[#050505]">
      {finalImageUrl && !isRawVideo ? (
          <img src={finalImageUrl} alt={titulo} loading="lazy" class="w-full h-auto aspect-square object-cover grayscale group-hover:grayscale-0 transition-all duration-700" />
      ) : isRawVideo || (esVideo && embedUrl && !isYoutube && !isInstagram) ? (
          <video src={embedUrl || finalImageUrl} class="w-full h-auto aspect-square object-cover grayscale group-hover:grayscale-0 transition-all duration-700 pointer-events-none" autoplay loop muted playsinline preload="metadata"></video>
      ) : (
          <div class="w-full h-full aspect-square bg-[#0a0a0a] flex items-center justify-center">
              <span class="text-white/20 text-4xl font-black tracking-widest uppercase">NT</span>
          </div>
      )}
      
      {esVideo && embedUrl && (
          <div class="absolute top-4 left-4 z-20 bg-white/10 backdrop-blur-md rounded-full p-2 border border-white/20 shadow-lg pointer-events-none">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="white" stroke="none"><polygon points="5 3 19 12 5 21 5 3"/></svg>
          </div>
      )}
      
      {/* Title overlay */}
      <div class="absolute inset-0 bg-gradient-to-t from-black via-black/40 to-transparent flex flex-col justify-end p-6 opacity-0 group-hover:opacity-100 transition-opacity duration-500 z-10">
        <h4 class="text-white font-bold uppercase tracking-widest md:text-lg text-base drop-shadow-md">{titulo}</h4>
        <p class="text-tattoo-gold text-xs tracking-[0.2em] mt-1 uppercase drop-shadow-md">{sede}</p>
      </div>
  </div>

  {/* IA Etiquetas */}
  {tagsArray.length > 0 && (
      <div class="w-full bg-[#050505] p-3 flex flex-wrap justify-between gap-y-2 border-t border-white/10">
          <div class="flex flex-wrap gap-1.5 w-full">
            {tagsArray.slice(0, 5).map(tag => (
                <span class="text-[8px] md:text-[9px] font-bold text-white/40 border border-white/10 bg-white/5 px-2 py-1 rounded-md uppercase tracking-widest backdrop-blur-sm">{tag}</span>
            ))}
          </div>
      </div>
  )}
</div>

{/* 2. LIGHTBOX MODAL (Oculto por defecto) */}
<div id={`modal-${uniqueId}`} class="fixed inset-0 z-[100] bg-[#050505]/98 backdrop-blur-xl opacity-0 pointer-events-none transition-opacity duration-500 flex flex-col items-center justify-center">
    
    {/* Top Bar */}
    <div class="absolute top-0 left-0 w-full p-4 md:p-6 flex justify-between items-center z-[110] bg-gradient-to-b from-black/80 to-transparent">
        <div>
            <h4 class="text-tattoo-gold font-bold uppercase tracking-widest text-lg md:text-xl drop-shadow-lg">{titulo}</h4>
            <p class="text-white/60 text-xs tracking-[0.2em] mt-1 uppercase relative inline-block">
                {sede}
            </p>
        </div>
        <button class="modal-close text-white hover:text-tattoo-gold bg-white/5 hover:bg-white/10 rounded-full p-3 backdrop-blur-md transition-colors" aria-label="Cerrar media">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
        </button>
    </div>

    {/* Media Track */}
    <div class="relative w-full h-[80vh] md:max-w-5xl md:h-[85vh] flex items-center justify-center overflow-hidden">
        <div class="w-full h-full flex items-center justify-center p-4">
            {esVideo && embedUrl ? (
                isRawVideo ? (
                    <div class="w-full max-w-5xl aspect-video h-auto bg-black rounded-lg overflow-hidden border border-white/10 shadow-2xl relative shadow-tattoo-gold/5 flex items-center justify-center">
                        <video src={embedUrl} class="w-full h-full object-contain" autoplay loop muted playsinline controls></video>
                    </div>
                ) : (
                    <div class={`w-full bg-black rounded-lg overflow-hidden border border-white/10 shadow-2xl relative shadow-tattoo-gold/5 ${isYoutube ? 'max-w-5xl aspect-video h-auto' : 'max-w-[400px] h-[80%] max-h-[700px]'}`}>
                        <iframe data-src={embedUrl} class="lazy-iframe w-full h-full border-none absolute inset-0" scrolling="no" allowtransparency="true" allow="autoplay; encrypted-media" allowfullscreen></iframe>
                    </div>
                )
            ) : isRawVideo ? (
                <div class="w-full max-w-5xl aspect-video h-auto bg-black rounded-lg overflow-hidden border border-white/10 shadow-2xl relative shadow-tattoo-gold/5 flex items-center justify-center">
                    <video src={finalImageUrl} class="w-full h-full object-contain drop-shadow-2xl" autoplay loop muted playsinline controls></video>
                </div>
            ) : (
                <img src={finalImageUrl} alt={titulo} loading="lazy" class="max-w-full max-h-full object-contain drop-shadow-2xl select-none" />
            )}
        </div>
    </div>
</div>

<script is:inline define:vars={{ uniqueId }}>
  document.addEventListener('DOMContentLoaded', () => {
      const trigger = document.querySelector(`[data-target="modal-${uniqueId}"]`);
      const modal = document.getElementById(`modal-${uniqueId}`);
      if (!trigger || !modal) return;

      const closeBtn = modal.querySelector('.modal-close');
      const iframe = modal.querySelector('.lazy-iframe');

      const openModal = () => {
          modal.classList.remove('opacity-0', 'pointer-events-none');
          document.body.style.overflow = 'hidden';
          if (iframe && !iframe.src && iframe.dataset.src) {
              iframe.src = iframe.dataset.src;
          }
      };

      const closeModal = () => {
          modal.classList.add('opacity-0', 'pointer-events-none');
          document.body.style.overflow = '';
          // Detener video al cerrar el modal
          if (iframe && iframe.src) {
              const src = iframe.src;
              iframe.src = '';
              iframe.src = src;
          }
      };

      trigger.addEventListener('click', openModal);
      if (closeBtn) closeBtn.addEventListener('click', closeModal);
      
      modal.addEventListener('click', (e) => {
          if (e.target === modal || e.target.tagName.toLowerCase() === 'img') {
              closeModal();
          }
      });
  });
</script>

