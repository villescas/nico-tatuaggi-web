---
const { titulo, imagenUrl, sede, linkVideo, esVideo, iaEtiquetas, galeria = [], enProceso = false, enProcesoLabel = 'En Curación' } = Astro.props;
const tagsArray = Array.isArray(iaEtiquetas) ? iaEtiquetas : (typeof iaEtiquetas === 'string' ? iaEtiquetas.split(',').map(s=>s.trim()) : []);
const uniqueId = `tattoo-${Math.random().toString(36).substr(2, 9)}`;

function extractYoutubeId(url) {
    if (!url) return null;
    const regExp = /^.*(youtu.be\/|v\/|u\/\w\/|embed\/|watch\?v=|&v=)([^#&?]*).*/;
    const match = url.match(regExp);
    return (match && match[2].length === 11) ? match[2] : null;
}

// Legacy single-media resolution (still used as a fallback for items with no `galeria`)
let embedUrl = null;
let finalImageUrl = imagenUrl;
let isYoutube = false;
let isInstagram = false;
let isRawVideo = false;

if (esVideo && linkVideo) {
    const ytId = extractYoutubeId(linkVideo);
    if (ytId) {
        isYoutube = true;
        embedUrl = `https://www.youtube.com/embed/${ytId}?autoplay=1&mute=0&controls=1&showinfo=0&rel=0&loop=1&playlist=${ytId}&playsinline=1`;
        if (!finalImageUrl) {
            finalImageUrl = `https://img.youtube.com/vi/${ytId}/hqdefault.jpg`;
        }
    } else if (linkVideo.includes('instagram.com/')) {
        isInstagram = true;
        const base = linkVideo.split('?')[0];
        const cleanBase = base.endsWith('/') ? base.slice(0, -1) : base;
        embedUrl = `${cleanBase}/embed/`;
    } else {
        isRawVideo = true;
        embedUrl = linkVideo;
    }
} else if (finalImageUrl && (finalImageUrl.includes('.mp4') || finalImageUrl.includes('.webm') || finalImageUrl.includes('.mov'))) {
    // Edge case: uploaded raw video file masquerading as a cover image
    isRawVideo = true;
}

// Unified slide list: the new multi-file gallery takes priority; otherwise fall back
// to the single legacy media resolved above (so old-style items keep working as-is).
const galleryItems = Array.isArray(galeria) ? galeria.filter((g) => g && g.url) : [];
const slides = galleryItems.length > 0
    ? galleryItems.map((g) => ({ kind: g.tipo === 'video' ? 'video' : 'image', src: g.url }))
    : (embedUrl || finalImageUrl)
        ? [{
            kind: (esVideo && embedUrl) ? (isYoutube ? 'youtube' : isInstagram ? 'instagram' : 'video') : 'image',
            src: (esVideo && embedUrl) ? embedUrl : finalImageUrl,
        }]
        : [];

const cover = slides[0] || null;
const coverIsVideo = cover?.kind === 'video';
const coverThumb = coverIsVideo ? (finalImageUrl || null) : (cover?.src || null);
---

{/* 1. THUMBNAIL EN LA GRILLA */}
<div class="relative group overflow-hidden border border-tattoo-gold/20 hover:border-tattoo-gold/60 transition-all duration-500 h-full w-full cursor-pointer tattoo-trigger flex flex-col hover-subtle-pulse" data-target={`modal-${uniqueId}`}>
  <div class="relative w-full bg-[#050505]">
      {coverIsVideo ? (
          <video data-src={cover.src} poster={coverThumb || undefined} class="cover-video w-full h-auto aspect-[4/5] object-cover transition-all duration-700 pointer-events-none" loop muted playsinline preload="none"></video>
      ) : coverThumb ? (
          <img src={coverThumb} alt={titulo} loading="lazy" class="w-full h-auto aspect-[4/5] object-cover transition-all duration-700" />
      ) : (
          <div class="w-full h-full aspect-[4/5] bg-[#0a0a0a] flex items-center justify-center">
              <span class="text-white/20 text-4xl font-black tracking-widest uppercase">NT</span>
          </div>
      )}

      {slides.length > 1 && (
          <div class="absolute top-4 right-4 z-20 bg-black/60 backdrop-blur-md rounded-full px-2.5 py-1 border border-white/20 shadow-lg pointer-events-none text-white text-[10px] font-bold tracking-widest">
              1/{slides.length}
          </div>
      )}

      {esVideo && embedUrl && (
          <div class="absolute top-4 left-4 z-20 bg-white/10 backdrop-blur-md rounded-full p-2 border border-white/20 shadow-lg pointer-events-none">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="white" stroke="none"><polygon points="5 3 19 12 5 21 5 3"/></svg>
          </div>
      )}

      {enProceso && (
          <div class="absolute top-4 left-4 z-20 bg-tattoo-gold/90 backdrop-blur-md rounded-full px-3 py-1 border border-white/20 shadow-lg pointer-events-none text-black text-[9px] font-bold tracking-widest uppercase">
              {enProcesoLabel}
          </div>
      )}
      
      {/* Title overlay */}
      <div class="absolute inset-0 bg-gradient-to-t from-black via-black/40 to-transparent flex flex-col justify-end p-6 opacity-0 group-hover:opacity-100 transition-opacity duration-500 z-10">
        <h4 class="text-white font-bold uppercase tracking-widest md:text-lg text-base drop-shadow-md">{titulo}</h4>
        <p class="text-tattoo-gold text-xs tracking-[0.2em] mt-1 uppercase drop-shadow-md">{sede}</p>
      </div>
  </div>

  {/* IA Etiquetas */}
  {tagsArray.length > 0 && (
      <div class="w-full bg-[#050505] p-3 flex flex-wrap justify-between gap-y-2 border-t border-white/10">
          <div class="flex flex-wrap gap-1.5 w-full">
            {tagsArray.slice(0, 5).map(tag => (
                <span class="text-[8px] md:text-[9px] font-bold text-white/40 border border-white/10 bg-white/5 px-2 py-1 rounded-md uppercase tracking-widest backdrop-blur-sm">{tag}</span>
            ))}
          </div>
      </div>
  )}
</div>

{/* 2. LIGHTBOX MODAL (Oculto por defecto) — imagen y texto en zonas separadas y fijas */}
<div id={`modal-${uniqueId}`} class="fixed inset-0 z-[100] bg-tattoo-black opacity-0 pointer-events-none transition-opacity duration-500 flex flex-col md:flex-row">

    {/* Stage: la foto/video, nunca recortada ni tapada. Ocupa todo lo que el
        panel de info no necesita (no una altura fija), asi una foto angosta
        no queda chica con barras negras a los costados. Swipeable en mobile. */}
    <div class="stage-area relative flex-1 min-h-0 md:flex-[0_0_68%] md:h-full bg-black overflow-hidden flex items-center justify-center [touch-action:pan-y]">
        {slides.map((slide, i) => (
            <div class="slide absolute inset-0 flex items-center justify-center p-0 md:p-10 transition-all duration-300 ease-out" data-index={i} style={i === 0 ? '' : 'opacity:0; pointer-events:none;'}>
                {slide.kind === 'video' ? (
                    <div class="w-full max-w-4xl aspect-video h-auto bg-black rounded-lg overflow-hidden border border-white/10 shadow-2xl relative shadow-tattoo-gold/5 flex items-center justify-center">
                        <video src={slide.src} class="w-full h-full object-contain" loop muted playsinline controls preload={i === 0 ? 'auto' : 'none'}></video>
                    </div>
                ) : slide.kind === 'youtube' ? (
                    <div class="w-full max-w-4xl aspect-video h-auto bg-black rounded-lg overflow-hidden border border-white/10 shadow-2xl relative shadow-tattoo-gold/5">
                        <iframe data-src={slide.src} class="lazy-iframe w-full h-full border-none absolute inset-0" scrolling="no" allowtransparency="true" allow="autoplay; encrypted-media" allowfullscreen></iframe>
                    </div>
                ) : slide.kind === 'instagram' ? (
                    <div class="w-full max-w-[400px] h-[80%] max-h-[700px] bg-black rounded-lg overflow-hidden border border-white/10 shadow-2xl relative shadow-tattoo-gold/5">
                        <iframe data-src={slide.src} class="lazy-iframe w-full h-full border-none absolute inset-0" scrolling="no" allowtransparency="true" allow="autoplay; encrypted-media" allowfullscreen></iframe>
                    </div>
                ) : (
                    <img src={slide.src} alt={titulo} loading="lazy" class="max-w-full max-h-full object-contain drop-shadow-2xl select-none" />
                )}
            </div>
        ))}

        <button class="modal-close absolute top-4 right-4 md:top-6 md:right-6 z-[110] text-white hover:text-tattoo-gold bg-white/5 hover:bg-white/10 rounded-full p-3 backdrop-blur-md transition-colors" aria-label="Cerrar media">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
        </button>

        <button class="slide-prev absolute left-2 md:left-4 top-1/2 -translate-y-1/2 z-[105] text-white hover:text-tattoo-gold bg-black/50 hover:bg-black/70 rounded-full p-3 backdrop-blur-md transition-colors" aria-label="Trabajo/foto anterior">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
        </button>
        <button class="slide-next absolute right-2 md:right-4 top-1/2 -translate-y-1/2 z-[105] text-white hover:text-tattoo-gold bg-black/50 hover:bg-black/70 rounded-full p-3 backdrop-blur-md transition-colors" aria-label="Siguiente trabajo/foto">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
        </button>

        {slides.length > 1 && (
            <div class="slide-counter absolute top-4 left-4 md:top-6 md:left-6 z-[105] bg-black/60 backdrop-blur-md rounded-full px-3 py-1 border border-white/20 text-white text-[11px] font-bold tracking-widest">
                1/{slides.length}
            </div>
        )}
    </div>

    {/* Separador (solo desktop) */}
    <div class="hidden md:block w-px bg-gradient-to-b from-transparent via-tattoo-gold/25 to-transparent"></div>

    {/* Panel de info: ocupa solo lo que su contenido necesita (nunca le "roba"
        alto a la foto de arranque), con un tope + scroll propio para captions
        largas. Zona propia -- nunca se superpone a la foto. */}
    <div class="info-panel relative flex-none max-h-[42vh] md:max-h-none md:flex-[0_0_32%] md:max-w-[440px] md:min-w-[320px] bg-[#0a0a0a] -mt-5 md:mt-0 rounded-t-[22px] md:rounded-none shadow-[0_-10px_30px_rgba(0,0,0,0.5)] md:shadow-none overflow-y-auto overscroll-contain md:flex md:items-center">
        <div class="px-6 pt-3 pb-[calc(2rem+env(safe-area-inset-bottom))] md:px-10 md:py-14 w-full">
            <div class="md:hidden w-9 h-1 rounded-full bg-white/20 mx-auto mb-5"></div>

            <h4 class="font-display text-white text-base md:text-xl font-semibold leading-snug mb-4 md:mb-6">{titulo}</h4>

            <div class="hidden md:block w-11 h-px bg-tattoo-gold/40 mb-6"></div>

            <div class="flex items-center gap-2 text-tattoo-silver text-[11px] md:text-xs tracking-[0.15em] uppercase">
                <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-tattoo-gold flex-shrink-0"><path d="M12 22s-8-4.5-8-11.8A8 8 0 0 1 12 2a8 8 0 0 1 8 8.2c0 7.3-8 11.8-8 11.8z"/><circle cx="12" cy="10" r="3"/></svg>
                {sede}
            </div>

            {tagsArray.length > 0 && (
                <div class="flex flex-wrap gap-2 mt-5">
                    {tagsArray.map(tag => (
                        <span class="text-[9px] font-bold text-white/50 border border-white/10 bg-white/5 px-2.5 py-1.5 rounded-md uppercase tracking-widest">{tag}</span>
                    ))}
                </div>
            )}
        </div>
    </div>
</div>

<script is:inline define:vars={{ uniqueId }}>
  document.addEventListener('DOMContentLoaded', () => {
      const trigger = document.querySelector(`[data-target="modal-${uniqueId}"]`);
      const modal = document.getElementById(`modal-${uniqueId}`);
      if (!trigger || !modal) return;

      const closeBtn = modal.querySelector('.modal-close');
      const slideEls = Array.from(modal.querySelectorAll('.slide'));
      const prevBtn = modal.querySelector('.slide-prev');
      const nextBtn = modal.querySelector('.slide-next');
      const counterEl = modal.querySelector('.slide-counter');
      let activeIndex = 0;

      // Cover video in the grid thumbnail never loads or plays until it's
      // actually being looked at -- on desktop that means hovering the card
      // (like the reference site), on touch devices it means the card is
      // visibly on screen (there's no hover to gate on). With ~50 cards on
      // the page, loading/playing all of them upfront both saturates the
      // main thread (choppy playback) and fires ~16 unnecessary network
      // requests on page load, which is the "slow" the client is feeling.
      const coverVideo = trigger.querySelector('.cover-video');
      if (coverVideo) {
          const ensureLoaded = () => {
              if (!coverVideo.getAttribute('src') && coverVideo.dataset.src) {
                  coverVideo.src = coverVideo.dataset.src;
              }
          };
          const canHover = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
          if (canHover) {
              trigger.addEventListener('mouseenter', () => {
                  ensureLoaded();
                  coverVideo.play().catch(() => {});
              });
              trigger.addEventListener('mouseleave', () => {
                  coverVideo.pause();
              });
          } else {
              const coverObserver = new IntersectionObserver((entries) => {
                  entries.forEach((entry) => {
                      if (entry.isIntersecting) {
                          ensureLoaded();
                          coverVideo.play().catch(() => {});
                      } else {
                          coverVideo.pause();
                      }
                  });
              }, { threshold: 0.35 });
              coverObserver.observe(coverVideo);
          }
      }

      // Prev/next in the lightbox pages through this work's own photos/videos;
      // past either end it moves to the next/previous tattoo card in the grid
      // (in DOM order) so browsing the whole portfolio doesn't require closing
      // and reopening each one.
      const goToSibling = (direction) => {
          const allTriggers = Array.from(document.querySelectorAll('.tattoo-trigger'));
          const myIndex = allTriggers.indexOf(trigger);
          const siblingIndex = myIndex + direction;
          if (myIndex === -1 || siblingIndex < 0 || siblingIndex >= allTriggers.length) return;
          closeModal();
          allTriggers[siblingIndex].click();
      };
      const goNext = () => {
          if (activeIndex < slideEls.length - 1) showSlide(activeIndex + 1, 1);
          else goToSibling(1);
      };
      const goPrev = () => {
          if (activeIndex > 0) showSlide(activeIndex - 1, -1);
          else goToSibling(-1);
      };

      const activateSlide = (el) => {
          const iframe = el.querySelector('.lazy-iframe');
          if (iframe && !iframe.src && iframe.dataset.src) iframe.src = iframe.dataset.src;
          const video = el.querySelector('video');
          if (video) video.play().catch(() => {});
      };

      const deactivateSlide = (el) => {
          const video = el.querySelector('video');
          if (video) video.pause();
      };

      // direction: 1 = advancing (next), -1 = going back (prev). Ties the slide
      // motion to the gesture that triggered it -- swipe left visibly moves the
      // photo left, instead of every change looking like an identical crossfade.
      const showSlide = (index, direction = 1) => {
          if (!slideEls.length) return;
          const prevIndex = activeIndex;
          activeIndex = (index + slideEls.length) % slideEls.length;
          slideEls.forEach((el, i) => {
              if (i === activeIndex) {
                  el.style.transition = 'none';
                  el.style.opacity = '0';
                  el.style.transform = `translateX(${direction * 28}px)`;
                  el.style.pointerEvents = 'auto';
                  void el.offsetWidth; // force reflow so the transition below actually animates
                  el.style.transition = '';
                  requestAnimationFrame(() => {
                      el.style.opacity = '1';
                      el.style.transform = 'translateX(0)';
                  });
                  activateSlide(el);
              } else if (i === prevIndex) {
                  el.style.opacity = '0';
                  el.style.transform = `translateX(${direction * -28}px)`;
                  el.style.pointerEvents = 'none';
                  deactivateSlide(el);
              } else {
                  el.style.transition = 'none';
                  el.style.opacity = '0';
                  el.style.transform = 'translateX(0)';
                  el.style.pointerEvents = 'none';
                  void el.offsetWidth;
                  el.style.transition = '';
                  deactivateSlide(el);
              }
          });
          if (counterEl) counterEl.textContent = `${activeIndex + 1}/${slideEls.length}`;
      };

      if (prevBtn) prevBtn.addEventListener('click', (e) => { e.stopPropagation(); goPrev(); });
      if (nextBtn) nextBtn.addEventListener('click', (e) => { e.stopPropagation(); goNext(); });

      const openModal = () => {
          modal.classList.remove('opacity-0', 'pointer-events-none');
          document.body.style.overflow = 'hidden';
          showSlide(0);
      };

      const closeModal = () => {
          modal.classList.add('opacity-0', 'pointer-events-none');
          document.body.style.overflow = '';
          slideEls.forEach((el) => {
              deactivateSlide(el);
              const iframe = el.querySelector('.lazy-iframe');
              if (iframe && iframe.src) iframe.src = '';
          });
      };

      closeBtn.addEventListener('click', closeModal);
      modal.addEventListener('click', (e) => {
          if (e.target === modal) closeModal();
      });

      // Swipe left/right on the photo/video area moves to the next/previous
      // slide (same as the arrows). Scoped to the stage only, never the info
      // panel below/beside it, so dragging through a long caption on mobile
      // scrolls text instead of changing the photo.
      const stageArea = modal.querySelector('.stage-area');
      if (stageArea) {
          let touchStartX = 0;
          let touchStartY = 0;
          let touchTracking = false;
          const SWIPE_THRESHOLD = 48;

          stageArea.addEventListener('touchstart', (e) => {
              if (e.touches.length !== 1) return;
              touchStartX = e.touches[0].clientX;
              touchStartY = e.touches[0].clientY;
              touchTracking = true;
          }, { passive: true });

          stageArea.addEventListener('touchend', (e) => {
              if (!touchTracking) return;
              touchTracking = false;
              const touch = e.changedTouches[0];
              const dx = touch.clientX - touchStartX;
              const dy = touch.clientY - touchStartY;
              if (Math.abs(dx) > SWIPE_THRESHOLD && Math.abs(dx) > Math.abs(dy) * 1.5) {
                  if (dx < 0) goNext(); else goPrev();
              }
          }, { passive: true });
      }

      document.addEventListener('keydown', (e) => {
          if (modal.classList.contains('pointer-events-none')) return;
          if (e.key === 'Escape') closeModal();
          if (e.key === 'ArrowLeft') goPrev();
          if (e.key === 'ArrowRight') goNext();
      });

      trigger.addEventListener('click', openModal);
  });
</script>

<style is:global>
@keyframes ultra-subtle-pulse {
  0% { 
      -webkit-box-shadow: 0 0 0 0 rgba(212, 175, 55, 0.4);
      box-shadow: 0 0 0 0 rgba(212, 175, 55, 0.4); 
  }
  70% { 
      -webkit-box-shadow: 0 0 0 6px rgba(212, 175, 55, 0);
      box-shadow: 0 0 0 6px rgba(212, 175, 55, 0); 
  }
  100% { 
      -webkit-box-shadow: 0 0 0 0 rgba(212, 175, 55, 0);
      box-shadow: 0 0 0 0 rgba(212, 175, 55, 0); 
  }
}
.hover-subtle-pulse:hover {
  animation: ultra-subtle-pulse 2s infinite;
  -webkit-transform: translate3d(0, 0, 0);
  transform: translate3d(0, 0, 0);
  will-change: box-shadow;
}
</style>
