---
export interface Props {
  id: string | number;
  title: string;
  resume?: string;
  coverImage?: string;
  contentHtml?: string;
  galleryJson?: string; // stringified array of URLs
  linkUrl?: string;
  date?: string;
  readMoreText?: string;
}

const { 
    id, 
    title, 
    resume, 
    coverImage, 
    contentHtml, 
    galleryJson, 
    linkUrl, 
    date,
    readMoreText = "Ver Detalles"
} = Astro.props;

// Format Date safely
let formattedDate = '';
if (date) {
    try {
        const d = new Date(date);
        formattedDate = new Intl.DateTimeFormat('es-AR', { day: 'numeric', month: 'short', year: 'numeric' }).format(d);
    } catch (e) { }
}

// Encode HTML to inject safely into data-attributes
const encodedContent = encodeURIComponent(contentHtml || "");
const encodedGallery = encodeURIComponent(galleryJson || "[]");
const encodedTitle = encodeURIComponent(title || "");
const encodedResume = encodeURIComponent(resume || "");
---

<article 
  class="news-trigger group h-full min-h-[260px] w-full max-w-[400px] flex-shrink-0 flex flex-col justify-between bg-gradient-to-b from-[#0f0f0f] to-[#050505] border border-tattoo-gold/10 hover:border-tattoo-gold/40 cursor-pointer shadow-lg transition-all duration-300 p-6 md:p-8 relative overflow-hidden"
  style="flex: 0 0 auto; width: 85vw; max-width: 400px;"
  data-news-id={id}
  data-title={encodedTitle}
  data-date={formattedDate}
  data-resume={encodedResume}
  data-content={encodedContent}
  data-gallery={encodedGallery}
  data-link={linkUrl}
  onclick="window.openNewsModal(this)"
>
  {/* Subtle top bar interaction glow */}
  <div class="absolute inset-x-0 top-0 h-[2px] bg-tattoo-gold transform scale-x-0 group-hover:scale-x-100 transition-transform duration-500 origin-left"></div>

  <div class="flex flex-col flex-grow">
    {formattedDate && <span class="text-tattoo-gold text-[10px] tracking-[0.3em] uppercase mb-4 block">{formattedDate}</span>}
    
    <h3 class="text-white text-lg md:text-xl font-black uppercase tracking-widest leading-snug mb-4 group-hover:text-tattoo-gold transition-colors duration-300">
        {title}
    </h3>
    
    {resume && (
        <p class="text-tattoo-silver text-xs md:text-sm tracking-wider leading-relaxed line-clamp-4">
            {resume}
        </p>
    )}
  </div>
  
  <div class="mt-6 pt-4 border-t border-white/5 flex items-center justify-between text-tattoo-gold text-xs tracking-[0.2em] font-bold opacity-80 group-hover:opacity-100 transition-opacity">
    <span class="uppercase">{readMoreText}</span>
    <span class="transform group-hover:translate-x-2 transition-transform duration-300">→</span>
  </div>
</article>
