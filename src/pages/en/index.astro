---
import Layout from '../../layouts/Layout.astro';
import Destination from '../../components/destination.astro';
import NewsCard from '../../components/NewsCard.astro';
import NewsModal from '../../components/NewsModal.astro';
import CityForm from '../../components/CityForm.astro';
import Nav from '../../components/Nav.astro';
import MemePopup from '../../components/MemePopup.astro';

import { getAssetData, getAssetUrl, fetchDirectus } from '../../utils/directus.js';

function extractYoutubeId(url) {
    if (!url) return null;
    const regExp = /^.*(youtu.be\/|v\/|u\/\w\/|embed\/|watch\?v=|&v=)([^#&?]*).*/;
    const match = url.match(regExp);
    return (match && match[2].length === 11) ? match[2] : null;
}

// Fetch Data with Fallbacks
let viajes = [];
let news = [];
let perfil = {};
let popup = {};

try {
  // 1. Buscamos los Viajes
  const rawViajes = await fetchDirectus('destinations');
  if (rawViajes) {
      const viajesArray = Array.isArray(rawViajes) ? rawViajes : [];
      viajes = viajesArray.sort((a, b) => new Date(a.startDate).getTime() - new Date(b.startDate).getTime());
  }

  // 2. Buscamos Novedades
  const rawNews = await fetchDirectus('news', '?filter[visible][_eq]=true&fields=*.*');
  if (rawNews) {
      const rawNewsArray = Array.isArray(rawNews) ? rawNews : [rawNews];
      news = rawNewsArray.sort((a,b) => {
          if(a.date && b.date) return new Date(b.date).getTime() - new Date(a.date).getTime();
          return 0;
      });
  }

  // 3. Buscamos el Profile
  const rawProfile = await fetchDirectus('profile');
  if (rawProfile) {
      const profileData = Array.isArray(rawProfile) ? rawProfile[0] : rawProfile;
      if (profileData) {
          perfil = {
              name: profileData.name,
              whatsapp: profileData.whatsapp,
              instagram: profileData.instagram,
              heroBannerUrl: profileData.heroBanner ? getAssetUrl(profileData.heroBanner, 'width=1920&quality=85&format=webp') : null,
              heroBannerMime: profileData.heroBanner ? getAssetData(profileData.heroBanner)?.mime : null,
              heroBannerMobileUrl: profileData.heroBannerMobile ? getAssetUrl(profileData.heroBannerMobile, 'width=800&quality=85&format=webp') : null,
              heroBannerMobileMime: profileData.heroBannerMobile ? getAssetData(profileData.heroBannerMobile)?.mime : null,
              youtubeId: profileData.heroBannerYoutube ? extractYoutubeId(profileData.heroBannerYoutube) : null,
              youtubeMobileId: profileData.heroBannerMobileYoutube ? extractYoutubeId(profileData.heroBannerMobileYoutube) : null
          };
          if (!perfil.youtubeMobileId && perfil.youtubeId) {
             perfil.youtubeMobileId = perfil.youtubeId;
          }
      }
  }

  // 4. Buscamos el Popup
  const rawPopup = await fetchDirectus('popup');
  if (rawPopup) {
      const popupData = Array.isArray(rawPopup) ? rawPopup[0] : rawPopup;
      if (popupData) {
          popup = {
              popupActive: popupData.visible === true,
              popupImage: popupData.popupImage ? getAssetUrl(popupData.popupImage, 'width=800&quality=85&format=webp') : null,
              popupTitle: popupData.popupTitle,
              popupSubtitle: popupData.popupSubtitle,
              popupLink: popupData.popupLink
          };
      }
  }
} catch (e) {
    console.error("Error fetching from Directus", e);
}

// Fallback Data if Directus is empty
if (viajes.length === 0) {
  const today = new Date();
  const nextMonth = new Date(today);
  nextMonth.setMonth(today.getMonth() + 1);
  viajes = [
    { city: "Buenos Aires", country: "Argentina", startDate: today.toISOString(), endDate: nextMonth.toISOString() },
    { city: "Madrid", country: "Spain", startDate: "2026-05-10T00:00:00.000Z", endDate: "2026-05-20T00:00:00.000Z" }
  ];
}

if (news.length === 0) {
    news = [
        { id: 1, title: 'Coming Soon', resume: 'We will be publishing our latest news, interviews and publications very soon.', content: '<p>Stay tuned for updates.</p>', images: [], visible: true }
    ];
}

if (!perfil.name) {
    perfil = {
        name: "Nico Tatuaggi",
        whatsapp: "5491112345678",
        instagram: "https://instagram.com/nicotatuaggi"
    }
}
---

<Layout 
  title="Nico Tatuaggi | Realism Specialist"
  description="High-precision body art that transforms your story into a unique masterpiece. Specialist in realism and cover-ups."
>
  {popup.popupActive && (
    <MemePopup 
      image={popup.popupImage} 
      title={popup.popupTitle} 
      subtitle={popup.popupSubtitle} 
      link={popup.popupLink}
    />
  )}
  <NewsModal closeText="CLOSE" linkText="VISIT LINK" />
  <Nav />
  
  {/* Hero Section */}
  <section class="relative min-h-[90vh] flex flex-col items-center justify-center text-center px-6 pt-20 overflow-hidden">
    {/* Desktop/Default Banner */}
    {perfil.heroBannerUrl ? (
      perfil.heroBannerMime && perfil.heroBannerMime.startsWith('video/') ? (
        <video class={`absolute inset-0 w-full h-full object-cover opacity-80 ${perfil.heroBannerMobileUrl || perfil.youtubeMobileId ? 'hidden md:block' : ''}`} autoplay loop muted playsinline>
          <source src={perfil.heroBannerUrl} type={perfil.heroBannerMime} />
        </video>
      ) : (
        <div class={`absolute inset-0 bg-cover bg-center opacity-80 ${perfil.heroBannerMobileUrl || perfil.youtubeMobileId ? 'hidden md:block' : ''}`} style={`background-image: url('${perfil.heroBannerUrl}')`}></div>
      )
    ) : perfil.youtubeId ? (
      <div class={`absolute inset-0 w-full h-full opacity-80 overflow-hidden pointer-events-none ${perfil.youtubeMobileId && perfil.youtubeMobileId !== perfil.youtubeId ? 'hidden md:block' : ''}`}>
        <iframe 
          class="absolute w-[300vw] h-[300vh] top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 md:w-[150vw] md:h-[150vh]"
          src={`https://www.youtube.com/embed/${perfil.youtubeId}?autoplay=1&mute=1&controls=0&showinfo=0&rel=0&loop=1&playlist=${perfil.youtubeId}&playsinline=1`} 
          frameborder="0" 
          allow="autoplay; encrypted-media" 
          allowfullscreen>
        </iframe>
      </div>
    ) : null}

    {/* Mobile Specific Banner */}
    {perfil.heroBannerMobileUrl ? (
      perfil.heroBannerMobileMime && perfil.heroBannerMobileMime.startsWith('video/') ? (
        <video class="absolute inset-0 w-full h-full object-cover opacity-80 md:hidden" autoplay loop muted playsinline>
          <source src={perfil.heroBannerMobileUrl} type={perfil.heroBannerMobileMime} />
        </video>
      ) : (
        <div class="absolute inset-0 bg-cover bg-center opacity-80 md:hidden" style={`background-image: url('${perfil.heroBannerMobileUrl}')`}></div>
      )
    ) : perfil.youtubeMobileId && perfil.youtubeMobileId !== perfil.youtubeId ? (
       <div class="absolute inset-0 w-full h-full opacity-80 overflow-hidden md:hidden pointer-events-none">
        <iframe 
          class="absolute w-[400vw] h-[400vh] top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2"
          src={`https://www.youtube.com/embed/${perfil.youtubeMobileId}?autoplay=1&mute=1&controls=0&showinfo=0&rel=0&loop=1&playlist=${perfil.youtubeMobileId}&playsinline=1`} 
          frameborder="0" 
          allow="autoplay; encrypted-media" 
          allowfullscreen>
        </iframe>
      </div>
    ) : null}

    {/* Fallback Banner */}
    {!perfil.heroBannerUrl && !perfil.heroBannerMobileUrl && !perfil.youtubeId && !perfil.youtubeMobileId && (
      <div class="absolute inset-0 bg-[url('https://images.unsplash.com/photo-1611501275019-9b5cda994e8d?auto=format&fit=crop&q=80&w=1920')] bg-cover bg-center opacity-60"></div>
    )}
    
    {/* Dark Overlays for Text Contrast */}
    <div class="absolute inset-0 bg-tattoo-black/30 mix-blend-multiply"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-tattoo-black via-tattoo-black/40 to-transparent"></div>
    <div class="absolute inset-0 bg-gradient-to-b from-tattoo-black/60 via-transparent to-transparent"></div>
    
    <div class="relative z-10 w-full max-w-4xl mx-auto">
        <h2 class="text-tattoo-gold text-sm md:text-lg font-black tracking-[0.4em] uppercase mb-6 drop-shadow-md">Tattoo Artist</h2>
        <div class="mb-4 flex flex-col items-center">
            <span class="text-white/60 text-sm md:text-base tracking-[0.4em] uppercase font-light mb-2">Specialist in</span>
            <h1 class="text-3xl md:text-5xl lg:text-7xl font-black text-white uppercase tracking-tighter leading-none opacity-90 drop-shadow-2xl mt-2 text-center">
                Realism <span class="text-[0.5em] font-light align-middle text-tattoo-gold px-1 md:px-2">&</span> Cover-ups
            </h1>
        </div>
        <p class="text-tattoo-silver text-sm md:text-base tracking-widest max-w-2xl mx-auto mb-10 leading-loose uppercase">
            CREATING THE NEW, TRANSFORMING THE OLD
        </p>
        
        <div class="flex flex-col sm:flex-row gap-6 justify-center">
            <a href="/en/galeria" class="bg-tattoo-gold text-black font-bold uppercase tracking-[0.2em] py-4 px-10 hover:bg-white transition-colors duration-300">
                View Portfolio
            </a>
            <a href={`https://wa.me/${(perfil.whatsapp || '').replace('+', '')}?text=Hola%20Nico%2C%20estuve%20viendo%20tu%20portfolio%20web%20y%20me%20encantar%C3%ADa%20cotizar%20un%20tatuaje%20de%20realismo.`} target="_blank" class="border border-tattoo-gold/50 text-tattoo-gold hover:bg-tattoo-gold/10 font-bold uppercase tracking-[0.2em] py-4 px-10 transition-colors duration-300 animate-pulse-gold">
                Book Appointment
            </a>
        </div>
    </div>
  </section>

  {/* News Section */}
  <section class="w-full max-w-7xl mx-auto px-6 py-12 md:py-16 bg-[#080808]/50 border-t border-tattoo-gold/10">
    <div class="flex flex-col lg:flex-row justify-between items-center lg:items-end mb-8 md:mb-10 gap-6 text-center lg:text-left">
        <div>
            <h2 class="text-tattoo-gold text-sm tracking-[0.3em] uppercase mb-4">Latest</h2>
            <h3 class="text-2xl md:text-3xl text-white font-bold tracking-widest uppercase">News & Editorials</h3>
        </div>
    </div>
    
    <div class="w-full relative px-6 md:px-0 -mx-6 md:mx-0 overflow-hidden">
      {/* Container horizontal scrolling list */}
      <div class="flex gap-4 md:gap-6 overflow-x-auto snap-x snap-mandatory pt-2 pb-8 custom-scrollbar-horizontal w-full" style="scroll-snap-type: x mandatory;">
        {news.map((item) => {
          let cover = '';
          let gallery = [];
          if (item.images && Array.isArray(item.images)) {
              gallery = item.images.map((img: any) => {
                  if (typeof img === 'string') return getAssetUrl(img);
                  if (img.directus_files_id) return getAssetUrl(img.directus_files_id);
                  if (img.item) return getAssetUrl(img.item); 
                  return '';
              }).filter(Boolean);
              if (gallery.length > 0) cover = gallery[0];
          } else if (item.image) {
              cover = getAssetUrl(item.image);
              gallery = [cover];
          }

          return (
            <div class="snap-start flex-shrink-0 h-auto flex items-stretch">
                <NewsCard 
                  id={item.id}
                  title={item.title}
                  resume={item.resume}
                  coverImage={cover}
                  contentHtml={item.content}
                  galleryJson={JSON.stringify(gallery)}
                  linkUrl={item.url_link}
                  date={item.date || item.date_created}
                  readMoreText="Read More"
                />
            </div>
          )
        })}
      </div>
    </div>
  </section>

  <style>
    .custom-scrollbar-horizontal::-webkit-scrollbar {
        height: 6px;
    }
    .custom-scrollbar-horizontal::-webkit-scrollbar-track {
        background: #050505;
        border-radius: 10px;
    }
    .custom-scrollbar-horizontal::-webkit-scrollbar-thumb {
        background: rgba(212, 175, 55, 0.3);
        border-radius: 10px;
    }
    .custom-scrollbar-horizontal::-webkit-scrollbar-thumb:hover {
        background: rgba(212, 175, 55, 0.6);
    }
  </style>

  {/* Current Location / Destinations */}
  <section class="w-full max-w-5xl mx-auto px-6 py-8 md:py-12 border-t border-tattoo-gold/10">
    <div class="flex flex-col items-center mb-6 md:mb-8">
        <h2 class="text-tattoo-gold text-sm tracking-[0.3em] uppercase mb-4">Upcoming Destinations</h2>
        <h3 class="text-3xl text-white font-bold tracking-widest uppercase">Where to find me?</h3>
    </div>
    
    <div class="flex flex-wrap justify-center gap-8">
      {viajes.map((viaje) => (
        <Destination 
          city={viaje.city} 
          country={viaje.country} 
          startDate={viaje.startDate} 
          endDate={viaje.endDate}
          studioName={viaje.studioName}
          studioLink={viaje.studioLink}
        />
      ))}
    </div>
  </section>

  {/* Newsletter / Form */}
  <section class="w-full max-w-4xl mx-auto px-6 pt-16 pb-8">
    <CityForm />
  </section>
</Layout>



