---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Tattoo from '../../components/Tattoo.astro';

import { getAssetData, getAssetUrl, fetchDirectus } from '../../utils/directus.js';
let tatuajes = [];

try {
  const rawTattoos = await fetchDirectus('tatuajes', '?filter[visible][_eq]=true&limit=100&fields=*.*,en_proceso,archivos.directus_files_id.id,archivos.directus_files_id.type');
  if (rawTattoos) {
      const rawTattoosArray = Array.isArray(rawTattoos) ? rawTattoos : [rawTattoos];
      tatuajes = [...rawTattoosArray].reverse().filter(t => t).map(t => {
          const galeria = Array.isArray(t.archivos)
              ? t.archivos.map(a => a.directus_files_id).filter(Boolean).map(f => {
                  const isVideo = (f.type || '').startsWith('video/');
                  return {
                      url: isVideo ? getAssetUrl(f.id) : getAssetUrl(f.id, 'width=1000&quality=82&format=webp'),
                      tipo: isVideo ? 'video' : 'imagen'
                  };
              })
              : [];
          return {
              titulo: t.titulo,
              sede: t.sede,
              imagenUrl: t.imagen_portada ? t.imagen_portada : (t.archivo_local ? getAssetUrl(t.archivo_local, 'width=600&quality=80&format=webp') : null),
              iaEtiquetas: t.ia_etiquetas,
              galeria,
              enProceso: t.en_proceso === true
          };
      });
  }
} catch (e) {
    console.error("Error fetching from Directus", e);
}

// Fallback Data if Directus is empty
if (tatuajes.length === 0) {
    tatuajes = [
        { titulo: "Realistic Lion", sede: "Londres", imagenUrl: "https://images.unsplash.com/photo-1598371839696-5c5bb00bdc28?auto=format&fit=crop&q=80&w=800" },
        { titulo: "Woman Face", sede: "Buenos Aires", imagenUrl: "https://images.unsplash.com/photo-1611501275019-9b5cda994e8d?auto=format&fit=crop&q=80&w=800" },
        { titulo: "Clock and Roses", sede: "Londres", imagenUrl: "https://images.unsplash.com/photo-1590246814883-57832efa2629?auto=format&fit=crop&q=80&w=800" },
        { titulo: "Tiger", sede: "Buenos Aires", imagenUrl: "https://images.unsplash.com/photo-1562962230-16e4623d36e6?auto=format&fit=crop&q=80&w=800" },
        { titulo: "Japanese Dragon", sede: "Londres", imagenUrl: "https://images.unsplash.com/photo-1605369683796-01d81de54130?auto=format&fit=crop&q=80&w=800" },
        { titulo: "Wolf Cover Up", sede: "Buenos Aires", imagenUrl: "https://images.unsplash.com/photo-1550684376-efcbd6e3f031?auto=format&fit=crop&q=80&w=800" },
        { titulo: "Skull", sede: "Londres", imagenUrl: "https://images.unsplash.com/photo-1621252178972-2aa54ef84c33?auto=format&fit=crop&q=80&w=800" },
        { titulo: "Eye Microrealism", sede: "Buenos Aires", imagenUrl: "https://images.unsplash.com/photo-1565347878385-d7a8d78fe975?auto=format&fit=crop&q=80&w=800" },
        { titulo: "Flowers Cover Up", sede: "Londres", imagenUrl: "https://images.unsplash.com/photo-1611501275019-9b5cda994e8d?auto=format&fit=crop&q=80&w=800" }
    ];
}
---

<Layout 
  title="Nico Tatuaggi | Portfolio Gallery"
  description="Explore the full gallery of realism, color, and cover-up tattoos by Nico Tatuaggi."
  image={tatuajes.length > 0 && tatuajes[0].imagenUrl ? tatuajes[0].imagenUrl : 'https://images.unsplash.com/photo-1598371839696-5c5bb00bdc28?auto=format&fit=crop&q=80&w=1200'}
>
  <Nav />
  
  <main class="w-full min-h-screen pt-24 md:pt-32 pb-16 md:pb-24 px-6 max-w-7xl mx-auto">
    <div class="text-center mb-10 md:mb-16">
        <h1 class="text-5xl md:text-6xl font-black text-white uppercase tracking-tighter mb-4">Portfolio</h1>
        <p class="text-tattoo-gold text-sm tracking-[0.3em] uppercase max-w-2xl mx-auto">Explore the full gallery of works</p>
    </div>

    {/* Filters: chip with a check that lights up -- state and color never fight (see script).
        The icon reserves its own width via w-0/w-3.5 (not just scale), so the
        label is genuinely centered when inactive, not pushed by an invisible gap. */}
    <div class="flex flex-wrap justify-center gap-3 mb-10 md:mb-16 filter-buttons">
        <button class="filter-chip flex items-center justify-center px-5 py-2.5 rounded-full border border-tattoo-gold bg-tattoo-gold text-black shadow-[0_0_20px_rgba(212,175,55,0.25)] transition-all duration-300 text-xs tracking-widest uppercase active-filter" data-filter="all">
            <svg class="check-icon w-3.5 mr-2 h-3.5 flex-shrink-0 overflow-hidden transition-all duration-300 scale-100 opacity-100" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
            <span>All</span>
        </button>
        <button class="filter-chip flex items-center justify-center px-5 py-2.5 rounded-full border border-tattoo-gold/25 text-tattoo-silver hover:border-tattoo-gold/50 hover:text-white transition-all duration-300 text-xs tracking-widest uppercase" data-filter="black and grey">
            <svg class="check-icon w-0 mr-0 h-3.5 flex-shrink-0 overflow-hidden transition-all duration-300 scale-75 opacity-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
            <span>Black &amp; Grey</span>
        </button>
        <button class="filter-chip flex items-center justify-center px-5 py-2.5 rounded-full border border-tattoo-gold/25 text-tattoo-silver hover:border-tattoo-gold/50 hover:text-white transition-all duration-300 text-xs tracking-widest uppercase" data-filter="cover up">
            <svg class="check-icon w-0 mr-0 h-3.5 flex-shrink-0 overflow-hidden transition-all duration-300 scale-75 opacity-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
            <span>Cover Up</span>
        </button>
        <button class="filter-chip flex items-center justify-center px-5 py-2.5 rounded-full border border-tattoo-gold/25 text-tattoo-silver hover:border-tattoo-gold/50 hover:text-white transition-all duration-300 text-xs tracking-widest uppercase" data-filter="color">
            <svg class="check-icon w-0 mr-0 h-3.5 flex-shrink-0 overflow-hidden transition-all duration-300 scale-75 opacity-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
            <span>Color</span>
        </button>
    </div>

    {/* 4 explicit columns + JS round-robin distribution (see script below)
        instead of CSS multi-column: with few items (e.g. the "Cover Up"
        filter, 5 of 51) columns-4's automatic balancing can leave the last
        column empty instead of spreading evenly -- see DOCUMENTACION-PROYECTO.md */}
    <div class="portfolio-grid flex items-start gap-6" id="portfolio-grid">
      <div class="flex flex-col gap-6 flex-1 min-w-0 portfolio-col" data-col="0">
        {tatuajes.map((tatuaje) => (
          <div class="tattoo-item transition-all duration-500" data-tags={Array.isArray(tatuaje.iaEtiquetas) ? tatuaje.iaEtiquetas.join(',') : (tatuaje.iaEtiquetas || '')}>
              <Tattoo
              titulo={tatuaje.titulo}
              sede={tatuaje.sede}
              imagenUrl={tatuaje.imagenUrl}
              iaEtiquetas={tatuaje.iaEtiquetas}
              galeria={tatuaje.galeria}
              enProceso={tatuaje.enProceso}
              enProcesoLabel="Healing"
              />
          </div>
        ))}
      </div>
      <div class="hidden flex-col gap-6 flex-1 min-w-0 portfolio-col" data-col="1"></div>
      <div class="hidden flex-col gap-6 flex-1 min-w-0 portfolio-col" data-col="2"></div>
      <div class="hidden flex-col gap-6 flex-1 min-w-0 portfolio-col" data-col="3"></div>
    </div>
  </main>
</Layout>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const buttons = document.querySelectorAll('.filter-buttons button');
        const items = Array.from(document.querySelectorAll('.tattoo-item'));
        const cols = Array.from(document.querySelectorAll('.portfolio-col'));

        const mqMd = window.matchMedia('(min-width: 768px)');
        const mqLg = window.matchMedia('(min-width: 1024px)');
        const columnCount = () => (mqLg.matches ? 4 : mqMd.matches ? 2 : 1);

        // CSS multi-column balances by total content height, not one-item-per
        // -column -- with a filter that matches few items (e.g. "Cover Up", 5
        // of 51) it can leave trailing columns completely empty instead of
        // spreading evenly across all 4. Explicit column containers + a JS
        // round-robin sidestep that entirely, regardless of item count.
        const redistribute = () => {
            const n = columnCount();
            cols.forEach((col, i) => {
                const show = i < n;
                col.classList.toggle('hidden', !show);
                col.classList.toggle('flex', show);
            });
            const visible = items.filter((el) => el.style.display !== 'none');
            visible.forEach((el, i) => cols[i % n].appendChild(el));
        };

        // One toggle per button drives both the color state and the check icon
        // together, off the same boolean -- so "active" and "inactive" text
        // colors can never both apply at once (that's what made the active chip's
        // text unreadable before: gold text and black text were being added at
        // the same time and one silently won the cascade).
        const setActiveButton = (activeButton) => {
            buttons.forEach((btn) => {
                const isActive = btn === activeButton;
                btn.classList.toggle('active-filter', isActive);
                btn.classList.toggle('border-tattoo-gold', isActive);
                btn.classList.toggle('bg-tattoo-gold', isActive);
                btn.classList.toggle('text-black', isActive);
                btn.classList.toggle('shadow-[0_0_20px_rgba(212,175,55,0.25)]', isActive);
                btn.classList.toggle('border-tattoo-gold/25', !isActive);
                btn.classList.toggle('text-tattoo-silver', !isActive);
                const check = btn.querySelector('.check-icon');
                if (check) {
                    // Width (not just scale) is what's toggled -- at inactive the
                    // icon must take up zero layout space, or its reserved box
                    // pushes the label off-center even while invisible.
                    check.classList.toggle('w-3.5', isActive);
                    check.classList.toggle('mr-2', isActive);
                    check.classList.toggle('scale-100', isActive);
                    check.classList.toggle('opacity-100', isActive);
                    check.classList.toggle('w-0', !isActive);
                    check.classList.toggle('mr-0', !isActive);
                    check.classList.toggle('scale-75', !isActive);
                    check.classList.toggle('opacity-0', !isActive);
                }
            });
        };

        buttons.forEach(button => {
            button.addEventListener('click', () => {
                setActiveButton(button);

                const filterValue = button.getAttribute('data-filter').toLowerCase();

                // 3. Scan the gallery nodes and resolve Display matrices against the button value
                items.forEach(item => {
                    const itemTags = (item.getAttribute('data-tags') || '').toLowerCase();
                    if (filterValue === 'all' || itemTags.includes(filterValue)) {
                        item.style.display = 'block';
                        setTimeout(() => {
                            item.style.opacity = '1';
                            item.style.transform = 'scale(1)';
                        }, 50);
                    } else {
                        item.style.opacity = '0';
                        item.style.transform = 'scale(0.95)';
                        setTimeout(() => {
                             item.style.display = 'none';
                        }, 300);
                    }
                });

                // Wait for filtered-out items to finish transitioning to
                // display:none before recomputing columns off visibility.
                setTimeout(redistribute, 320);
            });
        });

        redistribute();
        mqMd.addEventListener('change', redistribute);
        mqLg.addEventListener('change', redistribute);
        // Direct resize fallback (rotating the phone, resizing the window):
        // not every browser fires matchMedia's 'change' consistently on
        // every breakpoint crossing.
        let resizeTimer = null;
        window.addEventListener('resize', () => {
            clearTimeout(resizeTimer);
            resizeTimer = setTimeout(redistribute, 150);
        });

        // Arriving from a "Browse by style" link on the home page (?filter=cover%20up)
        // applies that filter alone, no need for the visitor to touch it again.
        const requestedFilter = new URLSearchParams(window.location.search).get('filter');
        if (requestedFilter) {
            const target = Array.from(buttons).find(
                (btn) => btn.getAttribute('data-filter') === requestedFilter.toLowerCase()
            );
            if (target) target.click();
        }
    });
</script>

<script>


