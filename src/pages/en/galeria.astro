---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Tattoo from '../../components/Tattoo.astro';

import { getAssetData, getAssetUrl, fetchDirectus } from '../../utils/directus.js';
let tatuajes = [];

try {
  const rawTattoos = await fetchDirectus('tatuajes', '?filter[visible][_eq]=true&limit=100&fields=*.*');
  if (rawTattoos) {
      const rawTattoosArray = Array.isArray(rawTattoos) ? rawTattoos : [rawTattoos];
      tatuajes = [...rawTattoosArray].reverse().filter(t => t).map(t => ({
          titulo: t.titulo,
          sede: t.sede,
          imagenUrl: t.imagen_portada ? t.imagen_portada : (t.archivo_local ? getAssetUrl(t.archivo_local, 'width=600&quality=80&format=webp') : null),
          linkVideo: t.link_video,
          esVideo: t.es_video,
          iaEtiquetas: t.ia_etiquetas
      }));
  }
} catch (e) {
    console.error("Error fetching from Directus", e);
}

// Fallback Data if Directus is empty
if (tatuajes.length === 0) {
    tatuajes = [
        { titulo: "Realistic Lion", sede: "Londres", imagenUrl: "https://images.unsplash.com/photo-1598371839696-5c5bb00bdc28?auto=format&fit=crop&q=80&w=800", esVideo: false },
        { titulo: "Woman Face", sede: "Buenos Aires", imagenUrl: "https://images.unsplash.com/photo-1611501275019-9b5cda994e8d?auto=format&fit=crop&q=80&w=800", esVideo: false },
        { titulo: "Clock and Roses", sede: "Londres", imagenUrl: "https://images.unsplash.com/photo-1590246814883-57832efa2629?auto=format&fit=crop&q=80&w=800", esVideo: false },
        { titulo: "Tiger", sede: "Buenos Aires", imagenUrl: "https://images.unsplash.com/photo-1562962230-16e4623d36e6?auto=format&fit=crop&q=80&w=800", esVideo: false },
        { titulo: "Japanese Dragon", sede: "Londres", imagenUrl: "https://images.unsplash.com/photo-1605369683796-01d81de54130?auto=format&fit=crop&q=80&w=800", esVideo: false },
        { titulo: "Wolf Cover Up", sede: "Buenos Aires", imagenUrl: "https://images.unsplash.com/photo-1550684376-efcbd6e3f031?auto=format&fit=crop&q=80&w=800", esVideo: false },
        { titulo: "Skull", sede: "Londres", imagenUrl: "https://images.unsplash.com/photo-1621252178972-2aa54ef84c33?auto=format&fit=crop&q=80&w=800", esVideo: false },
        { titulo: "Eye Microrealism", sede: "Buenos Aires", imagenUrl: "https://images.unsplash.com/photo-1565347878385-d7a8d78fe975?auto=format&fit=crop&q=80&w=800", esVideo: false },
        { titulo: "Flowers Cover Up", sede: "Londres", imagenUrl: "https://images.unsplash.com/photo-1611501275019-9b5cda994e8d?auto=format&fit=crop&q=80&w=800", esVideo: false }
    ];
}
---

<Layout 
  title="Nico Tatuaggi | Portfolio Gallery"
  description="Explore the full gallery of realism, color, and cover-up tattoos by Nico Tatuaggi."
  image={tatuajes.length > 0 && tatuajes[0].imagenUrl ? tatuajes[0].imagenUrl : 'https://images.unsplash.com/photo-1598371839696-5c5bb00bdc28?auto=format&fit=crop&q=80&w=1200'}
>
  <Nav />
  
  <main class="w-full min-h-screen pt-24 md:pt-32 pb-16 md:pb-24 px-6 max-w-7xl mx-auto">
    <div class="text-center mb-10 md:mb-16">
        <h1 class="text-5xl md:text-6xl font-black text-white uppercase tracking-tighter mb-4">Portfolio</h1>
        <p class="text-tattoo-gold text-sm tracking-[0.3em] uppercase max-w-2xl mx-auto">Explore the full gallery of works</p>
    </div>

    {/* Filtros visuales usando Alpine o simple CSS/JS vanilla */}
    <div class="flex flex-wrap justify-center gap-4 mb-10 md:mb-16 filter-buttons">
        <button class="px-6 py-2 border border-tattoo-gold text-tattoo-gold hover:bg-tattoo-gold hover:text-black transition-colors text-xs tracking-widest uppercase active-filter" data-filter="all">All</button>
        <button class="px-6 py-2 border border-tattoo-gold/30 text-tattoo-silver hover:border-tattoo-gold hover:text-tattoo-gold transition-colors text-xs tracking-widest uppercase" data-filter="realismo">Realism</button>
        <button class="px-6 py-2 border border-tattoo-gold/30 text-tattoo-silver hover:border-tattoo-gold hover:text-tattoo-gold transition-colors text-xs tracking-widest uppercase" data-filter="black and grey">Black & Grey</button>
        <button class="px-6 py-2 border border-tattoo-gold/30 text-tattoo-silver hover:border-tattoo-gold hover:text-tattoo-gold transition-colors text-xs tracking-widest uppercase" data-filter="cover up">Cover Up</button>
        <button class="px-6 py-2 border border-tattoo-gold/30 text-tattoo-silver hover:border-tattoo-gold hover:text-tattoo-gold transition-colors text-xs tracking-widest uppercase" data-filter="color">Color</button>
    </div>

    <div class="columns-1 md:columns-2 lg:columns-4 gap-6 space-y-6 portfolio-grid">
      {tatuajes.map((tatuaje) => (
        <div class={`tattoo-item transition-all duration-500 break-inside-avoid mb-6`} data-tags={Array.isArray(tatuaje.iaEtiquetas) ? tatuaje.iaEtiquetas.join(',') : (tatuaje.iaEtiquetas || '')}>
            <Tattoo 
            titulo={tatuaje.titulo} 
            sede={tatuaje.sede} 
            imagenUrl={tatuaje.imagenUrl} 
            linkVideo={tatuaje.linkVideo}
            esVideo={tatuaje.esVideo}
            iaEtiquetas={tatuaje.iaEtiquetas}
            />
        </div>
      ))}
    </div>
  </main>
</Layout>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const buttons = document.querySelectorAll('.filter-buttons button');
        const items = document.querySelectorAll('.tattoo-item');

        buttons.forEach(button => {
            button.addEventListener('click', () => {
                // 1. Remove active state properties from all filter buttons
                buttons.forEach(btn => {
                    btn.classList.remove('border-tattoo-gold', 'text-tattoo-gold', 'bg-tattoo-gold', 'text-black', 'active-filter');
                    btn.classList.add('border-tattoo-gold/30', 'text-tattoo-silver');
                });
                
                // 2. Inject active state CSS properties into the triggering button
                button.classList.remove('border-tattoo-gold/30', 'text-tattoo-silver');
                button.classList.add('border-tattoo-gold', 'text-tattoo-gold', 'bg-tattoo-gold', 'text-black', 'active-filter');

                const filterValue = button.getAttribute('data-filter').toLowerCase();

                // 3. Scan the gallery nodes and resolve Display matrices against the button value
                items.forEach(item => {
                    const itemTags = (item.getAttribute('data-tags') || '').toLowerCase();
                    if (filterValue === 'all' || itemTags.includes(filterValue)) {
                        item.style.display = 'block';
                        setTimeout(() => {
                            item.style.opacity = '1';
                            item.style.transform = 'scale(1)';
                        }, 50);
                    } else {
                        item.style.opacity = '0';
                        item.style.transform = 'scale(0.95)';
                        setTimeout(() => {
                             item.style.display = 'none';
                        }, 300);
                    }
                });
            });
        });
    });
</script>

