---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';

const DIRECTUS_URL = import.meta.env.PUBLIC_DIRECTUS_URL || 'http://localhost:8055';
const DIRECTUS_TOKEN = import.meta.env.DIRECTUS_API_TOKEN || '';

const getAssetData = (obj) => {
    if (!obj) return null;
    if (typeof obj === 'string') return { id: obj, mime: null };
    if (obj.directus_files_id) return { id: obj.directus_files_id.id || obj.directus_files_id, mime: obj.directus_files_id.type };
    return { id: obj.id, mime: obj.type };
};

const getAssetUrl = (obj, params = '') => {
    if (!obj) return null;
    if (typeof obj === 'string' && obj.startsWith('http')) return obj;
    if (obj.url) return obj.url;
    const data = getAssetData(obj);
    if (!data || !data.id) return null;
    if (typeof data.id === 'string' && data.id.startsWith('http')) return data.id;
    return `${DIRECTUS_URL}/assets/${data.id}${params ? '?' + params : ''}`;
};

const fetchDirectus = async (endpoint) => {
  try {
    const res = await fetch(`${DIRECTUS_URL}/items/${endpoint}?filter[visible][_eq]=true&fields=*.*`, {
      headers: DIRECTUS_TOKEN ? { Authorization: `Bearer ${DIRECTUS_TOKEN}` } : {}
    });
    if (!res.ok) return null;
    const json = await res.json();
    return json.data;
  } catch (e) {
    return null;
  }
};

let careData = null;
let rawSteps = null;
try {
  const careResp = await fetchDirectus('care');
  careData = Array.isArray(careResp) ? careResp[0] : careResp;
  rawSteps = await fetchDirectus('care_steps');
} catch (e) {
  console.error("Error fetching Care data from Directus", e);
}

// Fallbacks
const pageTitle = careData?.title || "Cuidados";
const pageSubtitle = careData?.subtitle || "Guía para la curación perfecta de tu tatuaje";
const steps = Array.isArray(rawSteps) && rawSteps.length > 0 ? rawSteps : [
    {
        title: "El Vendaje Inicial",
        description: "➤ Mantén el film o vendaje protector puesto durante las primeras 2 a 4 horas después de salir del estudio.\n➤ Este vendaje inicial es crucial para proteger tu piel recién tatuada de bacterias y suciedad mientras tu cuerpo comienza el proceso de coagulación.\n➤ Si el tatuador te colocó un parche dérmico respirable (tipo Saniderm), puedes dejarlo entre 3 y 5 días según sus indicaciones específicas.",
        image: { url: "https://images.unsplash.com/photo-1522337360788-8b13dee7a37e?auto=format&fit=crop&q=80&w=800" }
    },
    {
        title: "El Primer Lavado",
        description: "➤ Lávate siempre bien las manos antes de tocar el tatuaje.\n➤ Usa agua tibia (no muy caliente) y un jabón neutro, preferiblemente sin perfume ni alcohol.\n➤ Lava la zona deslizando las yemas de tus dedos suavemente. Nunca uses esponjas, paños ni restriegues la piel.\n➤ El objetivo es limpiar los fluidos superficiales, sangre o exceso de tinta sin dañar la piel fresca.",
        image: { url: "https://images.unsplash.com/photo-1550537687-c9a0c9705227?auto=format&fit=crop&q=80&w=800" }
    },
    {
        title: "Secado y Oxigenación",
        description: "➤ El secado debe ser igual de cuidadoso que el lavado.\n➤ Utiliza servilletas de papel de cocina (tissue) limpias dando pequeños 'toques' sobre el tatuaje para absorber el agua.\n➤ NUNCA uses toallas de tela, ya que acumulan bacterias y sus hilos pueden engancharse en la piel.\n➤ Deja que el tatuaje respire libremente al aire durante unos 10 a 15 minutos antes de cubrirlo o aplicar cremas.",
        image: { url: "https://images.unsplash.com/photo-1584820927508-0125fb0ab691?auto=format&fit=crop&q=80&w=800" }
    },
    {
        title: "Hidratación Diaria",
        description: "➤ A partir del tercer día, cuando el tatuaje empiece a sentirse tirante o reseco, es momento de hidratar.\n➤ Aplica una capa EXTREMADAMENTE FINA de crema para el cuidado de tatuajes o loción sin perfume ni parabenos.\n➤ La piel debe tener un ligero brillo, pero no debe quedar una capa blanca de crema encima. El exceso de humedad ahoga el tatuaje y retrasa la curación.\n➤ Aplica la loción de 2 a 3 veces por día, o cada vez que lo laves, durante al menos las primeras 2 semanas.",
        image: { url: "https://images.unsplash.com/photo-1599305090598-fe179d501227?auto=format&fit=crop&q=80&w=800" }
    },
    {
        title: "Restricciones Críticas",
        description: "➤ Es normal que el tatuaje pique y se descame. ¡NO LO RASQUES NI ARRANCAS LAS COSTRAS! Dejarás cráteres sin tinta.\n➤ NO sumerjas el tatuaje bajo el agua: Evita piscinas, el mar, jacuzzis o largas inmersiones en la bañera durante al menos 3 semanas.\n➤ PROTÉGE LO DEL SOL: Durante el primer mes de sanación, mantenlo totalmente alejado del contacto directo con los rayos UV. Las quemaduras solares destruirán los pigmentos permanentemente.",
        image: { url: "https://images.unsplash.com/photo-1507525428034-b723cf961d3e?auto=format&fit=crop&q=80&w=800" }
    }
];
---

<Layout 
  title="Nico Tatuaggi | Cuidados"
  description="Guía esencial paso a paso para la curación perfecta de tu tatuaje: lavado, hidratación y precauciones."
  image="https://images.unsplash.com/photo-1608248593856-121f1981180b?auto=format&fit=crop&q=80&w=1200"
>
  <Nav />
  
  <main class="w-full min-h-screen pt-24 md:pt-32 pb-16 md:pb-24 px-6 max-w-4xl mx-auto">
    <div class="text-center mb-24">
        <h1 class="text-5xl md:text-6xl font-black text-white uppercase tracking-[0.2em] mb-4">{pageTitle}</h1>
        <p class="text-white/50 text-xs tracking-[0.4em] uppercase max-w-2xl mx-auto">{pageSubtitle}</p>
    </div>

    <div class="space-y-6">
        {steps.map((step, index) => {
            const imageUrl = step.image ? getAssetUrl(step.image, 'width=800&quality=80&format=webp') : "https://images.unsplash.com/photo-1584820927508-0125fb0ab691?auto=format&fit=crop&q=80&w=800";
            const paragraphs = step.description ? step.description.split('\n').filter(p => p.trim() !== '') : [];

            return (
                <div class="accordion-item bg-[#080808]/80 border border-white/5 relative overflow-hidden group hover:border-tattoo-gold/30 transition-colors duration-500 cursor-pointer">
                    <div class="accordion-header p-8 md:p-10 flex justify-between items-center relative z-10 w-full">
                        <div class="flex items-center gap-6">
                            <div class="text-tattoo-gold font-light opacity-80 w-10 h-10 flex items-center justify-center border border-tattoo-gold/30 rounded-full text-2xl flex-shrink-0">{index + 1}</div>
                            <h2 class="text-xl md:text-2xl font-bold text-white uppercase tracking-[0.3em]">{step.title ? step.title.replace(/^\d+[\.\-]?\s*/, '') : ''}</h2>
                        </div>
                        <div class="indicator text-tattoo-gold transition-transform duration-500">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
                        </div>
                    </div>
                    
                    <div class="accordion-content h-0 overflow-hidden transition-all duration-500 ease-in-out opacity-0 px-8 md:px-10 pb-0">
                        <div class="border-t border-white/10 pt-8 pb-10 flex flex-col md:flex-row gap-8 md:gap-12 items-start">
                            <div class={`text-white/60 font-light leading-loose space-y-6 text-sm md:text-base flex-1 ${index % 2 !== 0 ? 'md:order-2' : ''}`}>
                                {paragraphs.map(p => <p>{p}</p>)}
                            </div>
                            <div class={`w-full md:w-2/5 aspect-video overflow-hidden rounded-sm border border-white/5 relative group mt-4 md:mt-0 flex-shrink-0 ${index % 2 !== 0 ? 'md:order-1 mb-4 md:mb-0' : ''}`}>
                                <img src={imageUrl} alt={step.title} class="w-full h-full object-cover grayscale opacity-60 group-hover:grayscale-0 group-hover:opacity-100 transition-all duration-700 group-hover:scale-105" />
                                <div class="absolute inset-0 mix-blend-overlay group-hover:opacity-0 transition-opacity duration-500 bg-tattoo-gold/10"></div>
                            </div>
                        </div>
                    </div>
                </div>
            );
        })}
    </div>
    
    <div class="mt-20 text-center">
        <p class="text-white/30 text-xs tracking-[0.4em] uppercase">Ante cualquier duda o anomalía, contactate inmediatamente por WhatsApp.</p>
    </div>
  </main>
</Layout>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const accordionItems = document.querySelectorAll('.accordion-item');

        accordionItems.forEach(item => {
            const header = item.querySelector('.accordion-header');
            const content = item.querySelector('.accordion-content');
            const indicator = item.querySelector('.indicator');

            header.addEventListener('click', () => {
                const isOpen = item.classList.contains('active');

                // Cerrar todos
                accordionItems.forEach(otherItem => {
                    otherItem.classList.remove('active');
                    const otherContent = otherItem.querySelector('.accordion-content');
                    const otherIndicator = otherItem.querySelector('.indicator');
                    otherContent.style.height = '0px';
                    otherContent.classList.remove('opacity-100');
                    otherIndicator.style.transform = 'rotate(0deg)';
                    otherItem.classList.remove('border-tattoo-gold/50');
                });

                // Si no estaba abierto, abrirlo
                if (!isOpen) {
                    item.classList.add('active');
                    content.style.height = content.scrollHeight + 'px';
                    content.classList.add('opacity-100');
                    indicator.style.transform = 'rotate(180deg)';
                    item.classList.add('border-tattoo-gold/50');
                }
            });
        });
        
        // Abrir el primero por defecto
        if(accordionItems.length > 0) {
             accordionItems[0].querySelector('.accordion-header').click();
        }
    });
</script>



